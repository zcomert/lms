generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite's Prisma connector does not support native `enum` types
// (P1012 at `prisma migrate dev`). The four enums specified in the brief
// (Role, AccessMode, ContentStatus, EnrollmentMethod) are implemented below
// as `String` fields with identical field names, defaults, and allowed
// literal values ("STUDENT" | "INSTRUCTOR" | "ADMIN", etc.) so that
// downstream route code using these field names is unaffected.
//
// Lesson.contentType follows the same convention: a `String` field with
// allowed literals "VIDEO_YOUTUBE" | "DOCUMENT" | "QUIZ" | "LINK" | "TEXT".

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  avatarUrl    String?
  locale       String       @default("tr")
  role         String       @default("STUDENT")
  roles        String       @default("STUDENT")
  /// Doluysa hesap devre dışıdır: giriş yapamaz, mevcut token'ları reddedilir.
  disabledAt   DateTime?
  createdAt    DateTime     @default(now())
  instructorAssignments CourseInstructor[] @relation("InstructorAssignments")
  enrollments  Enrollment[]
  lessonProgress LessonProgress[]
  studyActivity StudyActivity[]
  quizGradesReceived QuizGrade[] @relation("QuizGradesReceived")
  quizGradesGiven    QuizGrade[] @relation("QuizGradesGiven")
  lessonFeedback LessonFeedback[]
  calendarEventsCreated CalendarEvent[] @relation("CalendarEventsCreated")
  announcementsAuthored Announcement[] @relation("AnnouncementsAuthored")
  questionBanksCreated QuestionBank[] @relation("QuestionBanksCreated")
  questionsCreated     Question[]     @relation("QuestionsCreated")
  examsCreated         Exam[]         @relation("ExamsCreated")
  examCandidacies      ExamCandidate[]
  lessonComments       LessonComment[]     @relation("LessonCommentsAuthored")
  courseReviews        CourseReview[]      @relation("CourseReviewsAuthored")
  courseReviewReplies  CourseReviewReply[] @relation("CourseReviewRepliesAuthored")
  assignmentsCreated              Assignment[]           @relation("AssignmentsCreated")
  assignmentAttachmentsUploaded   AssignmentAttachment[] @relation("AssignmentAttachmentsUploaded")
  assignmentSubmissions           AssignmentSubmission[] @relation("AssignmentSubmissions")
  assignmentSubmissionsGraded     AssignmentSubmission[] @relation("AssignmentSubmissionsGraded")
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  category    String
  level       String
  tags        String       @default("")
  accessMode  String       @default("FREE")
  status      String       @default("DRAFT")
  modules     Module[]
  enrollments Enrollment[]
  instructors CourseInstructor[]
  studyActivity StudyActivity[]
  calendarEvents CalendarEvent[]
  announcements Announcement[]
  questionBanks QuestionBank[]
  exams         Exam[]
  reviews       CourseReview[]
  assignments   Assignment[]
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int
  lessons  Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  order       Int
  status      String   @default("DRAFT")
  description String?
  // Allowed literals: "VIDEO_YOUTUBE" | "DOCUMENT" | "QUIZ" | "LINK" | "TEXT"
  contentType String   @default("DOCUMENT")
  contentUrl  String?
  lessonProgress LessonProgress[]
  quizGrades  QuizGrade[]
  lessonFeedback LessonFeedback[]
  comments    LessonComment[]
  assignments Assignment[]
}

/// Ders başına kullanıcı geri bildirimi: beğeni ve/veya 1–5 puan. İkisi de boşsa satır tutulmaz.
model LessonFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  liked     Boolean  @default(false)
  /// 1–5 arası; DB zorlamaz, API doğrular. Puan verilmediyse null.
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
}

model NavMenuItem {
  id        String   @id @default(cuid())
  path      String
  label     String
  icon      String
  order     Int
  roles     String   // CSV, e.g. "STUDENT,INSTRUCTOR,ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  method     String
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model CourseInstructor {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("InstructorAssignments", fields: [userId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([courseId, position])
}

/// Kullanıcı başına günlük çalışma süresi özeti. Ham olay tutulmaz; her istemci
/// bildirimi (heartbeat) ilgili satırın `seconds` değerini artırır.
/// Satır sayısı: kullanıcı × gün × çalışılan kurs × kategori (en fazla 3).
model StudyActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD, ACTIVITY_TIMEZONE (varsayılan Europe/Istanbul) takvimine göre.
  day       String
  /// Allowed literals: "VIDEO" | "QUIZ" | "READING" (dersin contentType'ından türetilir)
  category  String
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  /// Önek (userId, day) aralık sorgularını da karşılar; ayrı indeks gerekmez.
  @@unique([userId, day, courseId, category])
}

/// QUIZ türündeki derslerde öğrenci başına tek not (0–100). Yeniden not girişi kaydı günceller.
model QuizGrade {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("QuizGradesReceived", fields: [userId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// 0–100 arası tam sayı
  score      Int
  gradedById String?
  gradedBy   User?    @relation("QuizGradesGiven", fields: [gradedById], references: [id], onDelete: SetNull)
  /// Son not giriş/güncelleme zamanı (trend hesabında kullanılır)
  gradedAt   DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@index([userId, gradedAt])
}

/// Akademik takvim etkinliği. courseId boşsa genel (herkese görünür) etkinliktir;
/// doluysa yalnızca kursa kayıtlılar ve kursu yönetenler görür.
model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  /// Allowed literals: "lecture" | "lab" | "exam" | "deadline" | "holiday" | "event"
  type        String   @default("event")
  /// Zamanlı etkinlikte gerçek an (UTC). Tüm gün etkinlikte gün başı UTC 00:00 olarak saklanır.
  start       DateTime
  /// Bitiş (dahil değil). Tüm gün etkinlikte bitiş günü hariç, UTC 00:00.
  end         DateTime?
  allDay      Boolean  @default(false)
  location    String?
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation("CalendarEventsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([start])
  @@index([courseId, start])
}

/// Duyuru. courseId boşsa genel (herkese görünür) duyurudur; doluysa yalnızca kursa
/// kayıtlılar ve kursu yönetenler görür. Okuyucuya görünmesi için status PUBLISHED,
/// publishAt <= şimdi ve (varsa) expiresAt > şimdi olmalıdır.
model Announcement {
  id        String    @id @default(cuid())
  title     String
  /// Düz metin; paragraflar boş satırla ayrılır.
  body      String
  /// Allowed literals: "ACADEMIC" | "COURSE" | "IT" | "EVENT" | "GENERAL"
  category  String    @default("GENERAL")
  /// Allowed literals: "DRAFT" | "PUBLISHED"
  status    String    @default("DRAFT")
  /// Yayın anı (UTC). PUBLISHED iken her zaman dolu; gelecekteyse duyuru zamanlanmıştır.
  publishAt DateTime?
  /// Bu andan itibaren okuyuculara gösterilmez (UTC). Boşsa süresiz.
  expiresAt DateTime?
  pinned    Boolean   @default(false)
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation("AnnouncementsAuthored", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, publishAt])
  @@index([courseId])
}

/// Soru bankası. courseId boşsa genel bankadır (yalnızca ADMIN düzenler, eğitmenler okuyup
/// sınavlarında kullanabilir); doluysa kursun bankasıdır (ADMIN veya kursa atanmış eğitmen).
model QuestionBank {
  id          String     @id @default(cuid())
  name        String
  description String?
  courseId    String?
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?      @relation("QuestionBanksCreated", fields: [createdById], references: [id], onDelete: SetNull)
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([courseId])
}

/// Bankadaki soru. Tipe özgü içerik (şıklar, doğru cevaplar, eşleştirme çiftleri, rubrik) `content`
/// alanında JSON olarak tutulur; biçimi ve doğrulaması src/lib/questions.ts içindedir.
model Question {
  id          String         @id @default(cuid())
  bankId      String
  bank        QuestionBank   @relation(fields: [bankId], references: [id], onDelete: Cascade)
  /// Allowed literals: "SINGLE_CHOICE" | "MULTIPLE_CHOICE" | "TRUE_FALSE" | "FILL_BLANK" | "MATCHING" | "SHORT_ANSWER" | "ESSAY"
  type        String
  /// Soru metni. FILL_BLANK'te her boşluk "___" (en az üç alt çizgi) ile işaretlenir.
  stem        String
  content     String         @default("{}")
  /// Sonuç ekranında gösterilecek doğru cevap açıklaması (FR-45).
  explanation String?
  topic       String?
  /// Allowed literals: "EASY" | "MEDIUM" | "HARD"
  difficulty  String         @default("MEDIUM")
  /// Sınava eklenirken kullanılan varsayılan puan.
  points      Int            @default(1)
  createdById String?
  createdBy   User?          @relation("QuestionsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  examLinks   ExamQuestion[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([bankId])
}

/// Sınav tanımı (FR-42). Her sınav bir kursa aittir; kurs sonradan değiştirilemez.
model Exam {
  id                  String          @id @default(cuid())
  title               String
  description         String?
  courseId            String
  course              Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Allowed literals: "QUIZ" | "MIDTERM" | "FINAL" | "PRACTICE"
  type                String          @default("QUIZ")
  /// Allowed literals: "DRAFT" | "PUBLISHED"
  status              String          @default("DRAFT")
  /// Sınav penceresi (UTC). Boşsa o yönde sınır yoktur.
  startsAt            DateTime?
  endsAt              DateTime?
  /// Süre sınırı (dakika). Boşsa süresizdir.
  durationMinutes     Int?
  maxAttempts         Int             @default(1)
  /// Geçme notu (yüzde, 0–100). Boşsa geçme/kalma değerlendirilmez.
  passingScore        Int?
  shuffleQuestions    Boolean         @default(false)
  shuffleOptions      Boolean         @default(false)
  /// Doluysa her öğrenciye bağlı sorulardan bu kadarı rastgele seçilir (havuzdan seçim, NFR-83).
  randomQuestionCount Int?
  /// Sonuçta doğru cevaplar ve açıklamalar gösterilsin mi (FR-45).
  showResults         Boolean         @default(true)
  /// Allowed literals: "COURSE" (kursa kayıtlı herkes) | "SELECTED" (yalnızca ExamCandidate kayıtları)
  audience            String          @default("COURSE")
  createdById         String?
  createdBy           User?           @relation("ExamsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  questions           ExamQuestion[]
  candidates          ExamCandidate[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([courseId])
  @@index([status, startsAt])
}

/// Sınav–soru ilişkisi: sıra ve sınava özgü puan.
model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position   Int
  points     Int      @default(1)

  @@unique([examId, questionId])
  @@index([examId, position])
  @@index([questionId])
}

/// audience = "SELECTED" olan sınava girecek öğrenci. Öğrenci sınavın kursuna kayıtlı olmalıdır.
model ExamCandidate {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([examId, userId])
  @@index([userId])
}

/// Ders yorumu. parentId boşsa üst düzey öğrenci yorumudur; doluysa eğitmen/admin yanıtıdır.
/// Yalnızca tek seviye: yanıtın parentId'si her zaman üst düzey bir yoruma işaret eder (API zorlar).
model LessonComment {
  id         String          @id @default(cuid())
  lessonId   String
  lesson     Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  authorId   String
  author     User            @relation("LessonCommentsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     LessonComment?  @relation("LessonCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    LessonComment[] @relation("LessonCommentReplies")
  /// Yalnızca yanıtlarda dolu: yazıldığı andaki aktif rol. Allowed literals: "INSTRUCTOR" | "ADMIN"
  authorRole String?
  body       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  /// Yazar metni düzenlediyse son düzenleme anı.
  editedAt   DateTime?

  @@index([lessonId, parentId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId])
}

/// Kurs değerlendirmesi: öğrenci başına kurs başına en fazla bir kayıt.
model CourseReview {
  id        String              @id @default(cuid())
  courseId  String
  course    Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation("CourseReviewsAuthored", fields: [userId], references: [id], onDelete: Cascade)
  /// 1–5 arası tam sayı; DB zorlamaz, API doğrular.
  rating    Int
  body      String?
  replies   CourseReviewReply[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  editedAt  DateTime?

  @@unique([courseId, userId])
  @@index([courseId, createdAt])
  @@index([userId])
}

/// Değerlendirmeye eğitmen/admin yanıtı (tek seviye).
model CourseReviewReply {
  id         String       @id @default(cuid())
  reviewId   String
  review     CourseReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation("CourseReviewRepliesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  /// Allowed literals: "INSTRUCTOR" | "ADMIN"
  authorRole String
  body       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  editedAt   DateTime?

  @@index([reviewId, createdAt])
  @@index([authorId])
}

/// Ödev (FR-60). Kursa aittir; isteğe bağlı olarak aynı kurstaki bir derse iliştirilir.
/// Öğrenciler yalnızca PUBLISHED ödevleri görür.
model Assignment {
  id                String                 @id @default(cuid())
  courseId          String
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Doluysa ödev bu derse bağlıdır (ders aynı kursa ait olmalı; API zorlar). Ders silinirse bağ kopar.
  lessonId          String?
  lesson            Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title             String
  /// Düz metin; paragraflar boş satırla ayrılır.
  description       String
  /// Teslim tarihi (UTC). Sonrasında teslim kabul edilir ama isLate = true olur.
  dueAt             DateTime
  maxScore          Int                    @default(100)
  /// Teslimde kabul edilen uzantılar: küçük harf, noktasız, virgülle ayrılmış (ör. "pdf,zip"). Boşsa yalnızca metin teslimi.
  allowedExtensions String                 @default("")
  /// Allowed literals: "DRAFT" | "PUBLISHED"
  status            String                 @default("DRAFT")
  createdById       String?
  createdBy         User?                  @relation("AssignmentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  attachments       AssignmentAttachment[]
  submissions       AssignmentSubmission[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([courseId, dueAt])
  @@index([lessonId])
}

/// Eğitmenin ödeve eklediği açıklama dosyası. Dosya diskte UPLOAD_DIR/<storedName> olarak durur.
model AssignmentAttachment {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Kullanıcının yüklediği (sanitize edilmiş) dosya adı; yalnızca indirmede gösterilir.
  originalName String
  /// Diskteki rastgele ad (uzantısız, 32 hex). Kullanıcı girdisinden türetilmez.
  storedName   String     @unique
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?      @relation("AssignmentAttachmentsUploaded", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([assignmentId])
}

/// Öğrenci teslimi (FR-61). Ödev başına öğrenci başına tek teslim; güncellenemez.
model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("AssignmentSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  text         String?
  submittedAt  DateTime         @default(now())
  /// submittedAt > assignment.dueAt ise true (teslim anında hesaplanır, sonradan değişmez).
  isLate       Boolean          @default(false)
  /// 0–maxScore arası tam sayı; null ise henüz notlanmadı (FR-63).
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     User?            @relation("AssignmentSubmissionsGraded", fields: [gradedById], references: [id], onDelete: SetNull)
  files        SubmissionFile[]

  @@unique([assignmentId, userId])
  @@index([userId])
}

/// Teslime ait dosya. Dosya diskte UPLOAD_DIR/<storedName> olarak durur.
model SubmissionFile {
  id           String               @id @default(cuid())
  submissionId String
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String               @unique
  mimeType     String
  size         Int
  createdAt    DateTime             @default(now())

  @@index([submissionId])
}
